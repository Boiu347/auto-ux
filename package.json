{
  "name": "baidu-one-click-config",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "agent:simulate": "pnpm --filter @app/contracts build && pnpm --filter @app/agent-simulator simulate",
    "dev:down": "./scripts/dev-down.sh",
    "dev:up": "./scripts/dev-up.sh",
    "dev": "pnpm --filter @app/web dev",
    "e2e": "playwright test",
    "build": "pnpm --filter @app/web build",
    "test": "pnpm --filter @app/web test",
    "typecheck": "pnpm --filter @app/web typecheck",
    "lint": "pnpm --filter @app/web lint"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0"
  }
}
